{
  "expo": {
    "name": "Inner Glow",
    "slug": "innerglow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "innerglow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.innerglowai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Inner Glow uses your microphone when you choose to record a voice journal, such as a reflection about your day, or a sleep sound recording. With your separate AI permission, voice journals can be sent to OpenAI for transcription.",
        "NSAlarmKitUsageDescription": "Inner Glow schedules the wake-up alarms you enable in your sleep schedule. These alarms ring even when Silent Mode or Focus is on."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.matthill8286.innerglow",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F0",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#FAF7F0"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Inner Glow uses your microphone when you choose to record a voice journal, such as a reflection about your day, or a sleep sound recording. With your separate AI permission, voice journals can be sent to OpenAI for transcription."
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/urbanist/400Regular/Urbanist_400Regular.ttf",
              "node_modules/@expo-google-fonts/urbanist/500Medium/Urbanist_500Medium.ttf",
              "node_modules/@expo-google-fonts/urbanist/600SemiBold/Urbanist_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/urbanist/700Bold/Urbanist_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Urbanist",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/urbanist/400Regular/Urbanist_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/urbanist/500Medium/Urbanist_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/urbanist/600SemiBold/Urbanist_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/urbanist/700Bold/Urbanist_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "976af0c9-628b-4305-af26-76acbb4d1654"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/976af0c9-628b-4305-af26-76acbb4d1654"
    },
    "owner": "matthill8286"
  }
}
