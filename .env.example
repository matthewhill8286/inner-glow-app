# Stripe (publishable key only — secret key goes in Supabase Edge Function secrets)
# Used for Android + Web. iOS is REQUIRED to use Apple In-App Purchase via RevenueCat.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# RevenueCat (public SDK keys are safe to ship in the bundle)
# Get these from https://app.revenuecat.com → Project Settings → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY="appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY="goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# Supabase Edge Function Secrets (set via CLI, NOT in .env):
# supabase secrets set STRIPE_SECRET_KEY="sk_test_..."
# supabase secrets set STRIPE_WEBHOOK_SECRET="whsec_..."
# supabase secrets set OPENAI_API_KEY="sk-proj-..."


# Server-only RevenueCat configuration (Supabase secrets, never EXPO_PUBLIC_)
# REVENUECAT_SECRET_API_KEY: secret v1 API key with subscriber read permission
# REVENUECAT_WEBHOOK_AUTH: same random Bearer token used in RevenueCat webhooks
# REVENUECAT_ALLOW_SANDBOX=true during TestFlight validation; false for production
